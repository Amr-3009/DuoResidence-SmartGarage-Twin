
/* ═══════════════════════════════════════════════════════════════
   DIGITAL TWIN COMMAND — LoadingScreen.uss
   Theme: Industrial IoT / Smart City  |  Palette: DESIGN.md
═══════════════════════════════════════════════════════════════ */

/* ── Root ───────────────────────────────────────────────────── */
.loading-root {
    width: 100%;
    height: 100%;
    background-color: rgb(11, 19, 38);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ── Brand watermark (top-left) ─────────────────────────────── */
.brand-watermark {
    position: absolute;
    left: 28px;
    top: 24px;
    flex-direction: column;
}
.brand-watermark__label {
    font-size: 10px;
    color: rgb(76, 215, 246);
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.brand-watermark__name {
    font-size: 14px;
    color: rgb(134, 147, 151);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ── Center Block ───────────────────────────────────────────── */
.center-block {
    flex-direction: column;
    align-items: center;
    width: 400px;
}

/* Scene icon */
.scene-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background-color: rgba(23, 31, 51, 0.90);
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.25);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}
.scene-icon-wrapper__dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(76, 215, 246);
}

/* Scene name + status */
.scene-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(218, 226, 253);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}
.loading-status {
    font-size: 13px;
    color: rgb(134, 147, 151);
    margin-bottom: 36px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* ── Progress Bar ───────────────────────────────────────────── */
.progress-track {
    width: 340px;
    height: 3px;
    background-color: rgba(34, 42, 61, 0.90);
    border-radius: 4px;
    margin-bottom: 14px;
    overflow: hidden;
}
.progress-fill {
    height: 3px;
    width: 0%;
    background-color: rgb(76, 215, 246);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* Percentage label */
.progress-pct {
    font-size: 12px;
    color: rgb(134, 147, 151);
    -unity-text-align: middle-center;
    margin-bottom: 0;
    letter-spacing: 1px;
}

/* ── Bottom hint ────────────────────────────────────────────── */
.bottom-hint {
    position: absolute;
    bottom: 28px;
    flex-direction: row;
    align-items: center;
}
.bottom-hint__dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(61, 73, 76);
    margin-left: 6px;
    margin-right: 6px;
}
.bottom-hint__text {
    font-size: 11px;
    color: rgb(61, 73, 76);
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
}
