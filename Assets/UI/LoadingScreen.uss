
/* ── Root ───────────────────────────────────────────────────── */
.loading-root {
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 9);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ── Brand watermark (top-left) ─────────────────────────────── */
.brand-watermark {
    position: absolute;
    left: 28px;
    top: 24px;
    flex-direction: column;
}
.brand-watermark__label {
    font-size: 10px;
    color: rgb(60, 60, 56);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}
.brand-watermark__name {
    font-size: 14px;
    color: rgb(80, 80, 76);
    -unity-font-style: bold;
}

/* ── Center Block ───────────────────────────────────────────── */
.center-block {
    flex-direction: column;
    align-items: center;
    width: 400px;
}

/* Scene icon */
.scene-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background-color: rgb(22, 22, 20);
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}
.scene-icon-wrapper__dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(70, 140, 220);
}

/* Scene name + status */
.scene-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}
.loading-status {
    font-size: 13px;
    color: rgb(90, 90, 86);
    margin-bottom: 36px;
    -unity-text-align: middle-center;
}

/* ── Progress Bar ───────────────────────────────────────────── */
.progress-track {
    width: 340px;
    height: 3px;
    background-color: rgb(30, 30, 28);
    border-radius: 4px;
    margin-bottom: 14px;
    overflow: hidden;
}
.progress-fill {
    height: 3px;
    width: 0%;
    background-color: rgb(70, 140, 220);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* Percentage label */
.progress-pct {
    font-size: 12px;
    color: rgb(80, 80, 76);
    -unity-text-align: middle-center;
    margin-bottom: 0;
}

/* ── Bottom hint ────────────────────────────────────────────── */
.bottom-hint {
    position: absolute;
    bottom: 28px;
    flex-direction: row;
    align-items: center;
}
.bottom-hint__dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(50, 50, 46);
    margin-left: 6px;
    margin-right: 6px;
}
.bottom-hint__text {
    font-size: 11px;
    color: rgb(55, 55, 51);
    -unity-text-align: middle-center;
}
