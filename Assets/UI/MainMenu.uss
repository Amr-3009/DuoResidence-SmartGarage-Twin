
/* ── Root ─────────────────────────────────────────────────────── */
.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 15, 14);
    font-size: 14px;
}

/* ── Sidebar ──────────────────────────────────────────────────── */
.sidebar {
    width: 220px;
    min-width: 220px;
    height: 100%;
    background-color: rgb(20, 20, 19);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 20);
    flex-direction: column;
    padding-top: 28px;
    padding-bottom: 20px;
}

.brand {
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 20);
    margin-bottom: 8px;
}

.brand-label {
    font-size: 10px;
    color: rgb(90, 90, 86);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
}

.brand-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 230, 226);
    margin-bottom: 3px;
}

.brand-sub {
    font-size: 11px;
    color: rgb(90, 90, 86);
    white-space: normal;
}

/* ── Nav ──────────────────────────────────────────────────────── */
.nav-section {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    flex-grow: 1;
}

.nav-label {
    font-size: 10px;
    color: rgb(90, 90, 86);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-left: 12px;
    margin-bottom: 4px;
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 8px;
    margin-bottom: 2px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

.nav-item:hover {
    background-color: rgb(30, 30, 28);
}

.nav-item--active {
    background-color: rgb(30, 30, 28);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 25);
}

.nav-item__label {
    font-size: 14px;
    color: rgb(130, 130, 124);
    margin-left: 10px;
}

.nav-item--active .nav-item__label {
    color: rgb(220, 220, 215);
    -unity-font-style: bold;
}

.nav-item__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(100, 100, 95);
    border-radius: 3px;
}

.nav-item--active .nav-item__icon {
    background-color: rgb(200, 200, 195);
}

/* ── Sidebar Footer ───────────────────────────────────────────── */
.sidebar-footer {
    padding-left: 12px;
    padding-right: 12px;
}

.version-label {
    font-size: 10px;
    color: rgb(70, 70, 66);
    margin-left: 12px;
    margin-bottom: 8px;
}

.quit-btn {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 8px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

.quit-btn:hover {
    background-color: rgba(163, 45, 45, 0.18);
}

.quit-btn__label {
    font-size: 14px;
    color: rgb(180, 70, 70);
    margin-left: 10px;
}

.quit-btn__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(180, 70, 70);
    border-radius: 3px;
}

/* ── Main Content ─────────────────────────────────────────────── */
.main-content {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(15, 15, 14);
    position: relative;
}

/* ── Viewport (live camera preview) ──────────────────────────── */
.viewport {
    width: 100%;
    height: 100%;
    background-color: rgb(8, 8, 8);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.viewport__placeholder-label {
    font-size: 13px;
    color: rgb(70, 70, 66);
}

/* Top-left overlay badge on viewport */
.viewport-badge {
    position: absolute;
    left: 28px;
    top: 24px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 9, 0.65);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 5px 14px;
}
.viewport-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(70, 140, 220);
    margin-right: 7px;
}
.viewport-badge__label {
    font-size: 12px;
    color: rgb(170, 170, 165);
}

/* ══════════════════════════════════════════════════════════════
   POPUP OVERLAY (shared by Load Scene / Connect / Settings)
══════════════════════════════════════════════════════════════ */
.popup-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-overlay--visible {
    display: flex;
}

/* ── Popup Card ─────────────────────────────────────────────── */
.popup-card {
    width: 480px;
    background-color: rgba(20, 20, 19, 0.85);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 24px;
    flex-direction: column;
}

.popup-card--wide {
    width: 560px;
}

.popup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.popup-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
}

.popup-close {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgba(255,255,255,0.08);
    border-width: 0;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgb(130, 130, 124);
}
.popup-close:hover {
    background-color: rgba(255,255,255,0.14);
    color: rgb(200, 200, 195);
}

/* ── Popup Section Label ────────────────────────────────────── */
.popup-section-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(80, 80, 76);
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* ── Popup Scene Grid ───────────────────────────────────────── */
.popup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.popup-card-item {
    width: 140px;
    background-color: rgba(26, 26, 24, 0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 14px 12px 10px 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
}
.popup-card-item:hover {
    border-color: rgba(255,255,255,0.25);
    background-color: rgba(32, 32, 30, 0.9);
}
.popup-card-item--active {
    border-color: rgba(70, 140, 220, 0.45);
    background-color: rgba(24, 95, 165, 0.22);
}
.popup-card-item--locked {
    opacity: 0.35;
}
.popup-card-item--locked:hover {
    border-color: rgba(255,255,255,0.10);
    background-color: rgba(26, 26, 24, 0.85);
}

.popup-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}
.popup-icon--blue   { background-color: rgba(24, 95, 165, 0.28); }
.popup-icon--amber  { background-color: rgba(133, 79, 11, 0.28); }
.popup-icon--gray   { background-color: rgba(30,30,28,0.85); border-width:1px; border-color: rgba(255,255,255,0.12); }

.popup-icon__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
.popup-icon--blue  .popup-icon__dot { background-color: rgb(70, 140, 220); }
.popup-icon--amber .popup-icon__dot { background-color: rgb(200, 130, 50); }
.popup-icon--gray  .popup-icon__dot { background-color: rgb(70, 70, 66); }

.popup-card-item__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(210, 210, 205);
    margin-bottom: 2px;
}
.popup-card-item__meta {
    font-size: 10px;
    color: rgb(90, 90, 86);
}

/* ── Connect Popup ──────────────────────────────────────────── */
.connect-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(26, 26, 24, 0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 12px 16px;
    margin-bottom: 10px;
}
.connect-row__left {
    flex-direction: row;
    align-items: center;
}
.connect-row__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 12px;
}
.connect-row__dot--online  { background-color: rgb(100, 180, 40); }
.connect-row__dot--offline { background-color: rgb(90, 90, 86); }
.connect-row__label {
    font-size: 13px;
    color: rgb(200, 200, 195);
}
.connect-row__status {
    font-size: 11px;
    color: rgb(90, 90, 86);
}
.connect-btn {
    font-size: 12px;
    color: rgb(70, 140, 220);
    background-color: rgba(24, 95, 165, 0.18);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(70, 140, 220, 0.30);
    padding: 6px 14px;
}
.connect-btn:hover {
    background-color: rgba(24, 95, 165, 0.30);
}

/* ── Settings Popup ─────────────────────────────────────────── */
.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.08);
}
/* Apply this class to the final .settings-row in each group instead of
   using the unsupported :last-child pseudo-class in UI Toolkit USS. */
.settings-row--last {
    border-bottom-width: 0;
}
.settings-row__label {
    font-size: 13px;
    color: rgb(180, 180, 175);
}
.settings-row__value {
    font-size: 12px;
    color: rgb(110, 110, 105);
}
.settings-toggle {
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(40, 40, 38);
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
}
.settings-toggle--on {
    background-color: rgba(70, 140, 220, 0.55);
}
.settings-toggle__knob {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(220,220,215);
    margin: 2px;
    translate: 0 0;
}
.settings-toggle--on .settings-toggle__knob {
    translate: 18px 0;
}
