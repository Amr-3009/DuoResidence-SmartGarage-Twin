
/* ── Root ─────────────────────────────────────────────────────── */
.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 15, 14);
    font-size: 14px;
}

/* ── Sidebar ──────────────────────────────────────────────────── */
.sidebar {
    width: 220px;
    min-width: 220px;
    height: 100%;
    background-color: rgb(20, 20, 19);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 20);
    flex-direction: column;
    padding-top: 28px;
    padding-bottom: 20px;
}

.brand {
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 20);
    margin-bottom: 8px;
}

.brand-label {
    font-size: 10px;
    color: rgb(90, 90, 86);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
}

.brand-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 230, 226);
    margin-bottom: 3px;
}

.brand-sub {
    font-size: 11px;
    color: rgb(90, 90, 86);
    white-space: normal;
}

/* ── Nav ──────────────────────────────────────────────────────── */
.nav-section {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    flex-grow: 1;
}

.nav-label {
    font-size: 10px;
    color: rgb(90, 90, 86);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-left: 12px;
    margin-bottom: 4px;
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 8px;
    margin-bottom: 2px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    cursor: link;
}

.nav-item:hover {
    background-color: rgb(30, 30, 28);
}

.nav-item--active {
    background-color: rgb(30, 30, 28);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 25);
}

.nav-item__label {
    font-size: 14px;
    color: rgb(130, 130, 124);
    margin-left: 10px;
}

.nav-item--active .nav-item__label {
    color: rgb(220, 220, 215);
    -unity-font-style: bold;
}

.nav-item__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(100, 100, 95);
    border-radius: 3px;
}

.nav-item--active .nav-item__icon {
    background-color: rgb(200, 200, 195);
}

/* ── Sidebar Footer ───────────────────────────────────────────── */
.sidebar-footer {
    padding-left: 12px;
    padding-right: 12px;
}

.version-label {
    font-size: 10px;
    color: rgb(70, 70, 66);
    margin-left: 12px;
    margin-bottom: 8px;
}

.quit-btn {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 8px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    cursor: link;
}

.quit-btn:hover {
    background-color: rgba(163, 45, 45, 0.18);
}

.quit-btn__label {
    font-size: 14px;
    color: rgb(180, 70, 70);
    margin-left: 10px;
}

.quit-btn__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(180, 70, 70);
    border-radius: 3px;
}

/* ── Main Content ─────────────────────────────────────────────── */
.main-content {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(15, 15, 14);
}

/* ── TopBar ───────────────────────────────────────────────────── */
.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px 16px 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 20);
}

.page-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
    flex-grow: 1;
}

.status-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(59, 109, 17, 0.22);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(59, 109, 17, 0.40);
    padding: 4px 12px;
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(100, 180, 40);
    margin-right: 6px;
}

.status-text {
    font-size: 12px;
    color: rgb(100, 180, 40);
}

/* ── Content Area ─────────────────────────────────────────────── */
.content-area {
    flex-grow: 1;
    padding: 24px 28px;
    flex-direction: column;
}

/* ── Stats Row ────────────────────────────────────────────────── */
.stats-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.stat-card {
    flex-grow: 1;
    background-color: rgb(22, 22, 21);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255,255,255,15);
    padding: 12px 14px;
    margin-right: 10px;
    flex-direction: column;
}

.stat-card:last-child {
    margin-right: 0;
}

.stat-label {
    font-size: 11px;
    color: rgb(100, 100, 95);
    margin-bottom: 4px;
}

.stat-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
}

.stat-unit {
    font-size: 11px;
    color: rgb(80, 80, 76);
}

/* ── Status Panel ─────────────────────────────────────────────── */
.status-panel {
    background-color: rgb(22, 22, 21);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255,255,255,15);
    padding: 18px 20px;
    margin-bottom: 20px;
}

.status-panel__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(200, 200, 195);
    margin-bottom: 12px;
}

.status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 9px;
    padding-bottom: 9px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,12);
}

.status-row:last-child {
    border-bottom-width: 0;
}

.status-row__label {
    font-size: 13px;
    color: rgb(120, 120, 115);
    flex-grow: 1;
}

.badge {
    font-size: 11px;
    border-radius: 20px;
    padding: 2px 8px;
}

.badge--online {
    background-color: rgba(59, 109, 17, 0.22);
    color: rgb(100, 180, 40);
}

.badge--warning {
    background-color: rgba(133, 79, 11, 0.22);
    color: rgb(210, 140, 50);
}

/* ── Go To Scenes Button ──────────────────────────────────────── */
.goto-btn {
    align-self: center;
    font-size: 13px;
    color: rgb(180, 180, 175);
    background-color: rgb(28, 28, 26);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255,255,255,18);
    padding: 9px 20px;
    cursor: link;
}

.goto-btn:hover {
    background-color: rgb(35, 35, 33);
    color: rgb(220, 220, 215);
}

/* ── Section Label ────────────────────────────────────────────── */
.section-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(80, 80, 76);
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* ── Scene Grid ───────────────────────────────────────────────── */
.scene-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.scene-card {
    width: 180px;
    background-color: rgb(22, 22, 21);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255,255,255,15);
    padding: 18px 16px 14px 16px;
    margin-right: 12px;
    margin-bottom: 12px;
    flex-direction: column;
    cursor: link;
}

.scene-card:hover {
    border-color: rgba(255,255,255,35);
    background-color: rgb(28, 28, 26);
}

.scene-card--locked {
    cursor: arrow;
    opacity: 0.45;
}

.scene-card--locked:hover {
    border-color: rgba(255,255,255,15);
    background-color: rgb(22, 22, 21);
}

.scene-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.scene-icon--blue   { background-color: rgba(24, 95, 165, 0.25); }
.scene-icon--amber  { background-color: rgba(133, 79, 11, 0.25); }
.scene-icon--gray   {
    background-color: rgb(30, 30, 28);
    border-width: 1px;
    border-color: rgba(255,255,255,15);
}

.scene-icon__dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
}
.scene-icon--blue  .scene-icon__dot { background-color: rgb(70, 140, 220); }
.scene-icon--amber .scene-icon__dot { background-color: rgb(200, 130, 50); }
.scene-icon--gray  .scene-icon__dot { background-color: rgb(80, 80, 76); }

.scene-card__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(210, 210, 205);
    margin-bottom: 3px;
}

.scene-card__meta {
    font-size: 11px;
    color: rgb(90, 90, 86);
}
