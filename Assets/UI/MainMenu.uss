
/* ═══════════════════════════════════════════════════════════════
   DIGITAL TWIN COMMAND — MainMenu.uss
   Theme: Industrial IoT / Smart City  |  Palette: DESIGN.md
═══════════════════════════════════════════════════════════════ */

/* ── Root ─────────────────────────────────────────────────────── */
.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(11, 19, 38);
    font-size: 14px;
}

/* ── Sidebar ──────────────────────────────────────────────────── */
.sidebar {
    width: 220px;
    min-width: 220px;
    height: 100%;
    background-color: rgba(19, 27, 46, 0.95);
    border-right-width: 1px;
    border-right-color: rgba(76, 215, 246, 0.12);
    flex-direction: column;
    padding-top: 28px;
    padding-bottom: 20px;
}

.brand {
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(76, 215, 246, 0.10);
    margin-bottom: 8px;
}

.brand-label {
    font-size: 10px;
    color: rgb(76, 215, 246);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.brand-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(218, 226, 253);
    margin-bottom: 3px;
}

.brand-sub {
    font-size: 11px;
    color: rgb(134, 147, 151);
    white-space: normal;
}

/* ── Nav ──────────────────────────────────────────────────────── */
.nav-section {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    flex-grow: 1;
}

.nav-label {
    font-size: 10px;
    color: rgb(76, 215, 246);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-left: 12px;
    margin-bottom: 4px;
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 4px;
    margin-bottom: 2px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0,0,0,0);
}

.nav-item:hover {
    background-color: rgba(76, 215, 246, 0.06);
    border-left-color: rgba(76, 215, 246, 0.30);
}

.nav-item--active {
    background-color: rgba(76, 215, 246, 0.10);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgb(76, 215, 246);
}

.nav-item__label {
    font-size: 14px;
    color: rgb(134, 147, 151);
    margin-left: 10px;
}

.nav-item--active .nav-item__label {
    color: rgb(218, 226, 253);
    -unity-font-style: bold;
}

.nav-item__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(61, 73, 76);
    border-radius: 3px;
}

.nav-item--active .nav-item__icon {
    background-color: rgb(76, 215, 246);
}

/* ── Sidebar Footer ───────────────────────────────────────────── */
.sidebar-footer {
    padding-left: 12px;
    padding-right: 12px;
}

.version-label {
    font-size: 10px;
    color: rgb(61, 73, 76);
    margin-left: 12px;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.quit-btn {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 4px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

.quit-btn:hover {
    background-color: rgba(255, 180, 171, 0.10);
}

.quit-btn__label {
    font-size: 14px;
    color: rgb(255, 180, 171);
    margin-left: 10px;
}

.quit-btn__icon {
    width: 17px;
    height: 17px;
    background-color: rgb(255, 180, 171);
    border-radius: 3px;
}

/* ── Main Content ─────────────────────────────────────────────── */
.main-content {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(11, 19, 38);
    position: relative;
}

/* ── Viewport ─────────────────────────────────────────────────── */
.viewport {
    width: 100%;
    height: 100%;
    background-color: rgb(6, 14, 32);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.viewport__placeholder-label {
    font-size: 13px;
    color: rgb(61, 73, 76);
    letter-spacing: 1px;
}

/* Top-left overlay badge on viewport */
.viewport-badge {
    position: absolute;
    left: 28px;
    top: 24px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(11, 19, 38, 0.65);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.15);
    padding: 5px 14px;
}
.viewport-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(76, 215, 246);
    margin-right: 7px;
}
.viewport-badge__label {
    font-size: 12px;
    color: rgb(188, 201, 205);
    letter-spacing: 0.5px;
}

/* ══════════════════════════════════════════════════════════════
   POPUP OVERLAY
══════════════════════════════════════════════════════════════ */
.popup-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 14, 32, 0.65);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-overlay--visible {
    display: flex;
}

/* ── Popup Card (glassmorphic) ──────────────────────────────── */
.popup-card {
    width: 480px;
    background-color: rgba(23, 31, 51, 0.92);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.18);
    padding: 24px;
    flex-direction: column;
}

.popup-card--wide {
    width: 560px;
}

.popup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.popup-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(218, 226, 253);
}

.popup-close {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background-color: rgba(76, 215, 246, 0.08);
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.20);
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgb(134, 147, 151);
}
.popup-close:hover {
    background-color: rgba(76, 215, 246, 0.18);
    color: rgb(76, 215, 246);
}

/* ── Popup Section Label ────────────────────────────────────── */
.popup-section-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(76, 215, 246);
    letter-spacing: 2px;
    margin-bottom: 10px;
}

/* ── Popup Scene Grid ───────────────────────────────────────── */
.popup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.popup-card-item {
    width: 140px;
    background-color: rgba(34, 42, 61, 0.90);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.12);
    padding: 14px 12px 10px 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
}
.popup-card-item:hover {
    border-color: rgba(76, 215, 246, 0.40);
    background-color: rgba(45, 52, 73, 0.95);
}
.popup-card-item--active {
    border-color: rgba(76, 215, 246, 0.65);
    background-color: rgba(76, 215, 246, 0.10);
}
.popup-card-item--locked {
    opacity: 0.35;
}
.popup-card-item--locked:hover {
    border-color: rgba(76, 215, 246, 0.12);
    background-color: rgba(34, 42, 61, 0.90);
}

.popup-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}
.popup-icon--blue   { background-color: rgba(76, 215, 246, 0.14); }
.popup-icon--amber  { background-color: rgba(255, 184, 115, 0.14); }
.popup-icon--gray   { background-color: rgba(45, 52, 73, 0.85); border-width:1px; border-color: rgba(76, 215, 246, 0.12); }

.popup-icon__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
.popup-icon--blue  .popup-icon__dot { background-color: rgb(76, 215, 246); }
.popup-icon--amber .popup-icon__dot { background-color: rgb(255, 184, 115); }
.popup-icon--gray  .popup-icon__dot { background-color: rgb(61, 73, 76); }

.popup-card-item__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(218, 226, 253);
    margin-bottom: 2px;
}
.popup-card-item__meta {
    font-size: 10px;
    color: rgb(134, 147, 151);
}

/* ── Connect Popup ──────────────────────────────────────────── */
.connect-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(34, 42, 61, 0.90);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.12);
    padding: 12px 16px;
    margin-bottom: 10px;
}
.connect-row__left {
    flex-direction: row;
    align-items: center;
}
.connect-row__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 12px;
}
.connect-row__dot--online  { background-color: rgb(76, 215, 246); }
.connect-row__dot--offline { background-color: rgb(61, 73, 76); }
.connect-row__label {
    font-size: 13px;
    color: rgb(218, 226, 253);
}
.connect-row__status {
    font-size: 11px;
    color: rgb(134, 147, 151);
    letter-spacing: 0.5px;
}
.connect-btn {
    font-size: 12px;
    color: rgb(76, 215, 246);
    background-color: rgba(76, 215, 246, 0.10);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.30);
    padding: 6px 14px;
    letter-spacing: 0.5px;
}
.connect-btn:hover {
    background-color: rgba(76, 215, 246, 0.20);
    border-color: rgba(76, 215, 246, 0.55);
}

/* ── Settings Popup ─────────────────────────────────────────── */
.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(76, 215, 246, 0.08);
}
.settings-row--last {
    border-bottom-width: 0;
}
.settings-row__label {
    font-size: 13px;
    color: rgb(188, 201, 205);
}
.settings-row__value {
    font-size: 12px;
    color: rgb(134, 147, 151);
    letter-spacing: 0.5px;
}
.settings-toggle {
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(34, 42, 61, 0.90);
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.15);
}
.settings-toggle--on {
    background-color: rgba(76, 215, 246, 0.30);
    border-color: rgba(76, 215, 246, 0.55);
}
.settings-toggle__knob {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(218, 226, 253);
    margin: 2px;
    translate: 0 0;
}
.settings-toggle--on .settings-toggle__knob {
    translate: 18px 0;
    background-color: rgb(76, 215, 246);
}
