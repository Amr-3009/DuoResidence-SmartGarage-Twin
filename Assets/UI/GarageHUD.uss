
/* ── HUD Root ───────────────────────────────────────────────── */
.hud-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgba(0,0,0,0);
}

/* ── Top Bar ────────────────────────────────────────────────── */
.hud-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: rgba(0,0,0,0);
}

.hud-topbar__left {
    flex-direction: row;
    align-items: center;
}

.hud-topbar__right {
    flex-direction: row;
    align-items: center;
}

/* ── Back Button ────────────────────────────────────────────── */
.back-btn {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 9, 0.80);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 8px 16px;
    cursor: link;
    margin-right: 12px;
}
.back-btn:hover {
    background-color: rgba(10, 10, 9, 0.95);
    border-color: rgba(255,255,255,0.25);
}
.back-btn__arrow {
    font-size: 14px;
    color: rgb(160, 160, 155);
    margin-right: 6px;
    -unity-font-style: bold;
}
.back-btn__label {
    font-size: 13px;
    color: rgb(210, 210, 205);
    -unity-font-style: bold;
}

/* ── Scene Pill ─────────────────────────────────────────────── */
.scene-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 9, 0.65);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 5px 14px;
}
.scene-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(70, 140, 220);
    margin-right: 7px;
}
.scene-pill__label {
    font-size: 12px;
    color: rgb(170, 170, 165);
}

/* ── Scenes Button ──────────────────────────────────────────── */
.scenes-btn {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 9, 0.80);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 8px 16px;
    cursor: link;
}
.scenes-btn:hover {
    background-color: rgba(10, 10, 9, 0.95);
    border-color: rgba(255,255,255,0.25);
}
.scenes-btn__icon {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: rgb(160, 160, 155);
    margin-right: 7px;
}
.scenes-btn__label {
    font-size: 13px;
    color: rgb(210, 210, 205);
    -unity-font-style: bold;
}

/* ══════════════════════════════════════════════════════════════
   POPUP OVERLAY
══════════════════════════════════════════════════════════════ */
.popup-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.70);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-overlay--visible {
    display: flex;
}

/* ── Popup Card ─────────────────────────────────────────────── */
.popup-card {
    width: 520px;
    background-color: rgb(20, 20, 19);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 24px;
    flex-direction: column;
}

.popup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.popup-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
}

.popup-close {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgba(255,255,255,0.08);
    border-width: 0;
    cursor: link;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgb(130, 130, 124);
}
.popup-close:hover {
    background-color: rgba(255,255,255,0.14);
    color: rgb(200, 200, 195);
}

/* ── Popup Section Label ────────────────────────────────────── */
.popup-section-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(80, 80, 76);
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* ── Popup Scene Grid ───────────────────────────────────────── */
.popup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.popup-card-item {
    width: 140px;
    background-color: rgb(26, 26, 24);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 14px 12px 10px 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
    cursor: link;
}
.popup-card-item:hover {
    border-color: rgba(255,255,255,0.25);
    background-color: rgb(32, 32, 30);
}
.popup-card-item--active {
    border-color: rgba(70, 140, 220, 0.45);
    background-color: rgba(24, 95, 165, 0.18);
}
.popup-card-item--locked {
    cursor: arrow;
    opacity: 0.35;
}
.popup-card-item--locked:hover {
    border-color: rgba(255,255,255,0.10);
    background-color: rgb(26, 26, 24);
}

.popup-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}
.popup-icon--blue   { background-color: rgba(24, 95, 165, 0.28); }
.popup-icon--amber  { background-color: rgba(133, 79, 11, 0.28); }
.popup-icon--gray   { background-color: rgb(30,30,28); border-width:1px; border-color: rgba(255,255,255,0.12); }

.popup-icon__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
.popup-icon--blue  .popup-icon__dot { background-color: rgb(70, 140, 220); }
.popup-icon--amber .popup-icon__dot { background-color: rgb(200, 130, 50); }
.popup-icon--gray  .popup-icon__dot { background-color: rgb(70, 70, 66); }

.popup-card-item__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(210, 210, 205);
    margin-bottom: 2px;
}
.popup-card-item__meta {
    font-size: 10px;
    color: rgb(90, 90, 86);
}
