/* ── Parking grid tiles — labeled slots ────────────────────── */
.dash-parking-grid { flex-direction: row; flex-wrap: wrap; gap: 2px; }

.dash-parking-tile {
    width: 26px;
    height: 16px;
    border-radius: 2px;
    background-color: rgba(30,58,42,1.00);
    border-width: 1px;
    border-color: rgba(42,90,58,0.80);
    font-size: 7px;
    -unity-font-style: bold;
    color: rgba(61,220,132,0.70);
    -unity-text-align: middle-center;
    overflow: hidden;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
    padding: 0;
    margin: 0;
}
.dash-parking-tile--occupied {
    background-color: rgba(200,60,60,0.80);
    border-color: rgba(224,92,92,0.00);
    border-width: 0;
    color: rgba(255,200,200,0.60);
}

.dash-lane-legend { flex-direction: row; margin-top: 5px; align-items: center; }
.dash-legend-dot  { width: 7px; height: 7px; border-radius: 2px; margin-right: 3px; }
.dash-legend-dot--free     { background-color: rgba(42,90,58,0.90); border-width: 1px; border-color: rgba(42,90,58,1.00); }
.dash-legend-dot--occupied { background-color: rgba(224,92,92,0.75); }
.dash-legend-text { font-size: 8px; color: rgb(74,122,171); margin-right: 8px; }

