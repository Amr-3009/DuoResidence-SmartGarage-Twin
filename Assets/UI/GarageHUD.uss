
/* ── HUD Root ───────────────────────────────────────────────── */
.hud-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgba(0,0,0,0);
}

/* ── Top Bar ────────────────────────────────────────────────── */
.hud-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: rgba(0,0,0,0);
}

.hud-topbar__left {
    flex-direction: row;
    align-items: center;
}

.hud-topbar__right {
    flex-direction: row;
    align-items: center;
}

/* ── Hamburger Menu Button ─────────────────────────────────── */
.hamburger-btn {
    width: 40px;
    height: 40px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 10, 9, 0.80);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 0;
}
.hamburger-btn:hover {
    background-color: rgba(10, 10, 9, 0.95);
    border-color: rgba(255,255,255,0.25);
}
.hamburger-btn__bar {
    width: 18px;
    height: 2px;
    border-radius: 1px;
    background-color: rgb(210, 210, 205);
    margin: 2px 0;
}

/* ── Scene Pill ─────────────────────────────────────────────── */
.scene-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 9, 0.65);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 5px 14px;
}
.scene-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(70, 140, 220);
    margin-right: 7px;
}
.scene-pill__label {
    font-size: 12px;
    color: rgb(170, 170, 165);
}

/* ══════════════════════════════════════════════════════════════
   HAMBURGER DROPDOWN MENU
══════════════════════════════════════════════════════════════ */
.hud-menu-dropdown {
    position: absolute;
    top: 64px;
    left: 20px;
    width: 200px;
    background-color: rgb(20, 20, 19);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    flex-direction: column;
    padding: 6px;

    opacity: 0;
    scale: 1 0.85;
    translate: 0px -8px;
    transform-origin: top left;

    transition-property: opacity, scale, translate;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.hud-menu-dropdown--open {
    opacity: 1;
    scale: 1 1;
    translate: 0px 0px;
}

.hud-menu-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 8px;
    padding: 10px 12px;
    margin: 0;
}
.hud-menu-item:hover {
    background-color: rgba(255,255,255,0.06);
}

.hud-menu-item__icon {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(160, 160, 155);
    margin-right: 10px;
    width: 14px;
    -unity-text-align: middle-center;
}

.hud-menu-item__icon-box {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: rgb(160, 160, 155);
    margin-right: 10px;
}

.hud-menu-item__label {
    font-size: 13px;
    color: rgb(210, 210, 205);
    -unity-font-style: bold;
}

.hud-menu-divider {
    height: 1px;
    background-color: rgba(255,255,255,0.08);
    margin: 4px 6px;
}

/* ══════════════════════════════════════════════════════════════
   POPUP OVERLAY
══════════════════════════════════════════════════════════════ */
.popup-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.70);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-overlay--visible {
    display: flex;
}

/* ── Popup Card ─────────────────────────────────────────────── */
.popup-card {
    width: 520px;
    background-color: rgb(20, 20, 19);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    padding: 24px;
    flex-direction: column;
}

.popup-card--dashboards {
    width: 740px;
    max-height: 640px;
}

.popup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.popup-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
}

.popup-close {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgba(255,255,255,0.08);
    border-width: 0;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgb(130, 130, 124);
}
.popup-close:hover {
    background-color: rgba(255,255,255,0.14);
    color: rgb(200, 200, 195);
}

/* ── Popup Section Label ────────────────────────────────────── */
.popup-section-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(80, 80, 76);
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* ── Popup Scene Grid ───────────────────────────────────────── */
.popup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.popup-card-item {
    width: 140px;
    background-color: rgb(26, 26, 24);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 14px 12px 10px 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
}
.popup-card-item:hover {
    border-color: rgba(255,255,255,0.25);
    background-color: rgb(32, 32, 30);
}
.popup-card-item--active {
    border-color: rgba(70, 140, 220, 0.45);
    background-color: rgba(24, 95, 165, 0.18);
}
.popup-card-item--locked {
    opacity: 0.35;
}
.popup-card-item--locked:hover {
    border-color: rgba(255,255,255,0.10);
    background-color: rgb(26, 26, 24);
}

.popup-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}
.popup-icon--blue   { background-color: rgba(24, 95, 165, 0.28); }
.popup-icon--amber  { background-color: rgba(133, 79, 11, 0.28); }
.popup-icon--gray   { background-color: rgb(30,30,28); border-width:1px; border-color: rgba(255,255,255,0.12); }

.popup-icon__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
.popup-icon--blue  .popup-icon__dot { background-color: rgb(70, 140, 220); }
.popup-icon--amber .popup-icon__dot { background-color: rgb(200, 130, 50); }
.popup-icon--gray  .popup-icon__dot { background-color: rgb(70, 70, 66); }

.popup-card-item__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(210, 210, 205);
    margin-bottom: 2px;
}
.popup-card-item__meta {
    font-size: 10px;
    color: rgb(90, 90, 86);
}

/* ══════════════════════════════════════════════════════════════
   DASHBOARDS POPUP
══════════════════════════════════════════════════════════════ */

/* ── Tab Bar ──────────────────────────────────────────────────── */
.dash-tabbar {
    flex-direction: row;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.08);
}

.dash-tab {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(120, 120, 115);
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0,0,0,0);
    border-radius: 0;
    padding: 8px 16px;
    margin-right: 4px;
    letter-spacing: 0.5px;
}
.dash-tab:hover {
    color: rgb(200, 200, 195);
}
.dash-tab--active {
    color: rgb(70, 140, 220);
    border-bottom-color: rgb(70, 140, 220);
}

/* ── Tab Content ──────────────────────────────────────────────── */
.dash-tab-content {
    flex-direction: column;
}

/* ── Progress Bars (Capacity / CO2 / NO) ─────────────────────── */
.dash-progress-track {
    width: 100%;
    height: 10px;
    background-color: rgb(35, 35, 33);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    margin-bottom: 8px;
    overflow: hidden;
}
.dash-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(100, 180, 40);
    border-radius: 6px;
}

.dash-value-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
    margin-bottom: 4px;
}

.dash-meta-label {
    font-size: 12px;
    color: rgb(130, 130, 124);
    margin-bottom: 16px;
}

/* ── Status Pills ─────────────────────────────────────────────── */
.dash-status-pill {
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 20px;
    padding: 5px 14px;
    letter-spacing: 0.5px;
}
.dash-status-pill--ok {
    background-color: rgba(100, 180, 40, 0.18);
    color: rgb(120, 200, 60);
}
.dash-status-pill--off {
    background-color: rgba(160, 70, 70, 0.18);
    color: rgb(210, 110, 110);
}

.dash-summary-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.dash-capacity-pct {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
}

/* ── Parking Lanes ────────────────────────────────────────────── */
.dash-lanes-row {
    flex-direction: row;
    justify-content: space-between;
}

.dash-lane-col {
    flex-direction: column;
    width: 32%;
}

.dash-lane-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(180, 180, 175);
    margin-bottom: 8px;
}

.dash-parking-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.dash-parking-tile {
    width: 14px;
    height: 14px;
    margin: 1px;
    border-radius: 3px;
    background-color: rgb(100, 180, 40);
}
.dash-parking-tile--occupied {
    background-color: rgb(200, 70, 70);
}

/* ── Fan Tab ──────────────────────────────────────────────────── */
.dash-fan-row {
    flex-direction: row;
    margin-bottom: 6px;
}
.dash-fan-card {
    flex-grow: 1;
    background-color: rgb(26, 26, 24);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    padding: 14px 16px;
    margin-right: 10px;
}
.dash-fan-card:last-of-type {
    margin-right: 0;
}

.dash-fan-controls {
    flex-direction: row;
    align-items: center;
}

.dash-dropdown {
    width: 140px;
    margin-right: 12px;
}

.dash-action-btn {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 220, 215);
    background-color: rgba(70, 140, 220, 0.20);
    border-width: 1px;
    border-color: rgba(70, 140, 220, 0.35);
    border-radius: 8px;
    padding: 10px 16px;
    letter-spacing: 0.5px;
}
.dash-action-btn:hover {
    background-color: rgba(70, 140, 220, 0.32);
}
.dash-action-btn:disabled {
    opacity: 0.45;
}

.dash-action-btn--green {
    background-color: rgba(100, 180, 40, 0.20);
    border-color: rgba(100, 180, 40, 0.35);
}
.dash-action-btn--green:hover {
    background-color: rgba(100, 180, 40, 0.32);
}

/* ── CCTV Tab ─────────────────────────────────────────────────── */
.dash-cctv-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.dash-cctv-stream {
    width: 100%;
    height: 220px;
    background-color: rgb(8, 8, 8);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 12px;
}

.dash-cctv-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.dash-cam-btn {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(180, 180, 175);
    background-color: rgb(26, 26, 24);
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    border-radius: 8px;
    padding: 8px 14px;
    margin-right: 8px;
    margin-bottom: 8px;
}
.dash-cam-btn:hover {
    background-color: rgb(34, 34, 32);
    border-color: rgba(255,255,255,0.22);
}
.dash-cam-btn--active {
    border-color: rgba(70, 140, 220, 0.5);
    background-color: rgba(24, 95, 165, 0.22);
    color: rgb(220, 220, 215);
}

/* ── CCTV Calibration (Overview-only deck) ─────────────────────── */
.dash-cctv-calib-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.dash-reset-btn {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(180, 180, 175);
    background-color: rgb(26, 26, 24);
    border-width: 1px;
    border-color: rgba(255,255,255,0.10);
    border-radius: 8px;
    padding: 4px 12px;
    margin-bottom: 10px;
}
.dash-reset-btn:hover {
    background-color: rgb(34, 34, 32);
    border-color: rgba(255,255,255,0.22);
}
.dash-reset-btn:disabled {
    opacity: 0.45;
}

/* ── Calibration Sliders ──────────────────────────────────────── */
.dash-calib-row {
    flex-direction: row;
    justify-content: space-between;
}

.dash-calib-row--single {
    justify-content: flex-start;
}

.dash-calib-col {
    width: 32%;
    flex-direction: column;
}

.dash-calib-col--wide {
    width: 100%;
}

.dash-calib-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(150, 150, 145);
    margin-bottom: 4px;
}

.dash-calib-slider {
    margin-bottom: 4px;
}
.dash-calib-slider .unity-base-slider__label {
    font-size: 10px;
    color: rgb(110, 110, 105);
    min-width: 32px;
}
.dash-calib-slider .unity-base-slider__tracker {
    background-color: rgb(40, 40, 38);
}
.dash-calib-slider .unity-base-slider__dragger {
    background-color: rgb(70, 140, 220);
    border-width: 0;
}
.dash-calib-col--wide .dash-calib-slider .unity-base-slider__label {
    min-width: 52px;
}
.dash-calib-col--wide .dash-calib-slider {
    width: 100%;
    max-width: 420px;
}
