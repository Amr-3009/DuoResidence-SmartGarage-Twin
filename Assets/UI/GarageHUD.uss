/* ── CCTV Calibration ──────────────────────────────────────────── */
.dash-cctv-calib-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.dash-reset-btn {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(188, 201, 205);
    background-color: rgba(34, 42, 61, 0.90);
    border-width: 1px;
    border-color: rgba(76, 215, 246, 0.12);
    border-radius: 4px;
    padding: 4px 12px;
    margin-bottom: 10px;
}
.dash-reset-btn:hover {
    background-color: rgba(45, 52, 73, 0.95);
    border-color: rgba(76, 215, 246, 0.35);
}
.dash-reset-btn:disabled {
    opacity: 0.35;
}

/* ── Calibration Sliders ──────────────────────────────────────── */
.dash-calib-row {
    flex-direction: row;
    justify-content: space-between;
}

.dash-calib-row--single {
    justify-content: flex-start;
}

.dash-calib-col {
    width: 32%;
    flex-direction: column;
}

.dash-calib-col--wide {
    width: 100%;
}

.dash-calib-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(134, 147, 151);
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.dash-calib-slider {
    margin-bottom: 4px;
}
.dash-calib-slider .unity-base-slider__label {
    font-size: 10px;
    color: rgb(134, 147, 151);
    min-width: 32px;
}
.dash-calib-slider .unity-base-slider__tracker {
    background-color: rgba(34, 42, 61, 0.90);
    border-color: rgba(76, 215, 246, 0.15);
    border-width: 1px;
}
.dash-calib-slider .unity-base-slider__dragger {
    background-color: rgb(76, 215, 246);
    border-width: 0;
}
.dash-calib-col--wide .dash-calib-slider .unity-base-slider__label {
    min-width: 52px;
}
.dash-calib-col--wide .dash-calib-slider {
    width: 100%;
    max-width: 420px;
}
